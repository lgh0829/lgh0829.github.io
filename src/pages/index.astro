---
import Base from '../layouts/Base.astro';
import Hexagon from '../components/Hexagon.astro';
import { site, headline, lab } from '../data/site';
import { cases } from '../data/cases';
import { stats } from '../data/stats';

const axesFor = (slug: string) => stats.filter((s) => s.cases.includes(slug));
---
<Base>
  <section class="wrap hero">
    <div>
      <p class="eyebrow">{site.role}</p>
      <h1>무엇을 만들지보다<br /><em>어떤 문제인지</em> 먼저 묻는 PO</h1>
      <p class="lead">
        AI를 도입해도 생산성이 오르지 않던 원인을 구현 속도가 아니라 사람 사이의 핸드오프에서 찾았습니다.
        헬스케어와 특허, 두 전문 산업에서 문제를 먼저 정의하고 그 답을 제품과 사업 성과로 완성해 왔습니다.
      </p>
      <div class="cta">
        <a class="btn primary" href="#stats">역량 보기</a>
        <a class="btn" href="#work">사례 보기</a>
      </div>
    </div>
    {site.photo
      ? <img class="avatar" src={site.photo} alt={site.photoAlt} width="440" height="440" />
      : <div class="avatar" aria-hidden="true"></div>}
  </section>

  <section id="stats" class="section">
    <div class="wrap">
      <p class="eyebrow">STATS</p>
      <h2>역량 육각형</h2>
      <p class="intro">여섯 가지 역량을 검증된 근거 기준으로 표시했습니다. 축을 누르면 근거와 관련 사례가 나옵니다.</p>
      <Hexagon />
      <ul class="headline">
        {headline.map((h) => (
          <li class="card">
            <strong>{h.value}</strong>
            <span>{h.label}</span>
            <small>{h.note}</small>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="work" class="section">
    <div class="wrap">
      <p class="eyebrow">SELECTED WORK</p>
      <h2>근거가 된 사례</h2>
      <div class="grid">
        {cases.map((c) => (
          <a class="card case" href={`/work/${c.slug}/`}>
            <small>{c.org} · {c.period}</small>
            <h3>{c.title}</h3>
            <p>{c.summary}</p>
            <div>{axesFor(c.slug).map((s) => <span class="tag">{s.label}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="section">
    <div class="wrap narrow">
      <p class="eyebrow">HOW I WORK</p>
      <h2>일하는 방식</h2>
      <ol class="steps">
        <li><strong>문제는 고객에게서</strong> VoC를 기다리지 않고 찾아가서, 문제를 좁혀간 논리를 기록합니다.</li>
        <li><strong>스펙은 실행 가능한 형태로</strong> 사람에게 넘기는 문서 대신 AI가 바로 수행하는 프롬프트·스킬로 씁니다.</li>
        <li><strong>결과는 숫자와 한계로</strong> 지표와 함께 가설이 틀린 부분도 남깁니다.</li>
      </ol>
    </div>
  </section>

  <section id="lab" class="section">
    <div class="wrap">
      <p class="eyebrow">LAB</p>
      <h2>사이드 프로젝트</h2>
      <div class="grid">
        {lab.map((l) => (
          <div class="card">
            <span class="tag">{l.tag}</span>
            <h3>{l.title}</h3>
            <p>{l.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="wrap narrow">
      <p class="eyebrow">CONTACT</p>
      <h2>함께 이야기해요</h2>
      <p>가장 빠른 연락 경로는 <a href={site.github}>GitHub</a>입니다.</p>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; padding-top: 72px; padding-bottom: 72px; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 700; letter-spacing: -0.025em; margin: 0 0 18px; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .lead { font-size: 1.12rem; color: var(--muted); max-width: 34em; }
  .avatar { width: 220px; height: 220px; object-fit: cover; object-position: center top; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); }
  .cta { display: flex; gap: 10px; margin-top: 24px; }
  .btn { padding: 11px 20px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.95rem; }
  .btn:hover { border-color: var(--ink); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .btn.primary:hover { filter: brightness(1.08); }
  h2 { font-size: clamp(1.6rem, 3vw, 2rem); margin: 0 0 12px; }
  .intro { color: var(--muted); margin: 0 0 24px; }
  .narrow { max-width: 760px; }
  .headline { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .headline li { display: flex; flex-direction: column; }
  .headline li { border-top: 3px solid var(--accent-strong); }
  .headline strong { font-size: 2.2rem; font-weight: 700; letter-spacing: -0.03em; color: var(--ink); }
  .headline span { font-weight: 600; }
  .headline small { color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 24px; }
  .grid h3 { margin: 6px 0 8px; font-size: 1.15rem; }
  .grid p { margin: 0 0 12px; color: var(--muted); font-size: 0.95rem; }
  .case { color: inherit; text-decoration: none; transition: border-color 0.15s; }
  .case:hover { border-color: var(--accent-strong); box-shadow: 0 6px 20px rgba(17, 20, 24, 0.06); transform: translateY(-2px); }
  .case small { color: var(--muted); }
  .steps { list-style: none; padding: 0; counter-reset: step; display: grid; gap: 12px; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 44px 1fr; gap: 4px 12px; padding: 18px 0; border-bottom: 1px solid var(--line); color: var(--muted); }
  .steps li::before { content: '0' counter(step); grid-row: span 2; font-weight: 700; color: var(--accent-strong); font-size: 1.1rem; }
  .steps strong { color: var(--ink); }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; padding-top: 40px; }
    .avatar { width: 120px; height: 120px; order: -1; }
    .headline { grid-template-columns: 1fr; }
  }
</style>
