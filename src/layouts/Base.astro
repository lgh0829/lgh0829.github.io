---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {site.photo && <meta property="og:image" content={new URL(site.photo, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/">{site.name}</a>
        <nav>
          <a href="/#stats">역량</a>
          <a href="/#work">사례</a>
          <a href="/#lab">Lab</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <a href={site.github}>GitHub</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --surface: #f7f8fa;
    --ink: #111418;
    --muted: #5b6270;
    --line: #e5e7eb;
    --accent: #c2410c;        /* 텍스트·버튼 배경 (흰 배경 대비 5.2:1) */
    --accent-strong: #ea580c; /* 그래픽·선 (3.6:1) */
    --accent-soft: #fff1e8;
    --on-accent: #ffffff;
    --fill: rgba(234, 88, 12, 0.16);
    --radius: 8px;
    --font: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    --serif: var(--font);
    --sans: var(--font);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0f1115;
      --surface: #171a20;
      --ink: #f2f3f5;
      --muted: #9aa1ae;
      --line: #262a33;
      --accent: #fb923c;
      --accent-strong: #f97316;
      --accent-soft: #2a1a10;
      --on-accent: #0f1115;
      --fill: rgba(249, 115, 22, 0.22);
    }
  }
  :root[data-theme='dark'] {
    --bg: #0f1115;
    --surface: #171a20;
    --ink: #f2f3f5;
    --muted: #9aa1ae;
    --line: #262a33;
    --accent: #fb923c;
    --accent-strong: #f97316;
    --accent-soft: #2a1a10;
    --on-accent: #0f1115;
    --fill: rgba(249, 115, 22, 0.22);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.7;
    word-break: keep-all;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); text-underline-offset: 3px; }
  h1, h2, h3 { font-weight: 600; line-height: 1.3; letter-spacing: -0.02em; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .section { padding: 88px 0; border-top: 1px solid var(--line); }
  .eyebrow {
    color: var(--accent); font-weight: 600; font-size: 0.78rem;
    letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 10px;
  }
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav { display: flex; justify-content: space-between; align-items: center; height: 60px; }
  .brand { font-weight: 700; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  .brand::before {
    content: ''; display: inline-block; width: 10px; height: 10px; margin-right: 8px;
    background: var(--accent-strong); border-radius: 2px; vertical-align: 1px;
  }
  .nav nav { display: flex; gap: 24px; }
  .nav nav a { color: var(--muted); text-decoration: none; font-size: 0.92rem; font-weight: 500; }
  .nav nav a:hover { color: var(--ink); }
  .site-footer { border-top: 1px solid var(--line); padding: 32px 0; color: var(--muted); font-size: 0.88rem; }
  .site-footer .wrap { display: flex; justify-content: space-between; }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .tag {
    display: inline-block;
    font-size: 0.75rem; font-weight: 500;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1px 8px;
    margin: 0 6px 6px 0;
  }
  @media (max-width: 560px) {
    .nav nav { gap: 14px; }
  }
</style>
