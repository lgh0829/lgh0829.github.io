---
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/profile.png', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/">{site.name}</a>
        <nav>
          <a href="/#stats">역량</a>
          <a href="/#work">사례</a>
          <a href="/#lab">Lab</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <a href={site.github}>GitHub</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f4ea;
    --surface: #ffffff;
    --ink: #1b2d35;
    --muted: #5b6b70;
    --line: #dcd6c4;
    --accent: #3f7050;
    --accent-soft: #9bc19b;
    --fill: rgba(155, 193, 155, 0.45);
    --serif: 'Noto Serif KR', serif;
    --sans: 'Noto Sans KR', system-ui, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #11191d;
      --surface: #1b2d35;
      --ink: #ece8dc;
      --muted: #a4b0ad;
      --line: #2f444c;
      --accent: #9bc19b;
      --accent-soft: #6f9a74;
      --fill: rgba(155, 193, 155, 0.3);
    }
  }
  :root[data-theme='dark'] {
    --bg: #11191d;
    --surface: #1b2d35;
    --ink: #ece8dc;
    --muted: #a4b0ad;
    --line: #2f444c;
    --accent: #9bc19b;
    --accent-soft: #6f9a74;
    --fill: rgba(155, 193, 155, 0.3);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.75;
    word-break: keep-all;
  }
  a { color: var(--accent); }
  h1, h2, h3 { font-family: var(--serif); line-height: 1.35; }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  .section { padding: 72px 0; border-top: 1px solid var(--line); }
  .eyebrow { color: var(--accent); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.08em; margin: 0 0 8px; }
  .site-header { position: sticky; top: 0; background: var(--bg); border-bottom: 1px solid var(--line); z-index: 10; }
  .nav { display: flex; justify-content: space-between; align-items: center; height: 56px; }
  .brand { font-family: var(--serif); font-weight: 700; color: var(--ink); text-decoration: none; }
  .nav nav { display: flex; gap: 18px; }
  .nav nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  .nav nav a:hover { color: var(--ink); }
  .site-footer { border-top: 1px solid var(--line); padding: 28px 0; color: var(--muted); font-size: 0.9rem; }
  .site-footer .wrap { display: flex; justify-content: space-between; }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 22px;
  }
  .tag {
    display: inline-block;
    font-size: 0.78rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 1px 10px;
    margin: 0 6px 6px 0;
  }
</style>
