---
import Base from './Base.astro';
import { stats } from '../data/stats';

const { frontmatter } = Astro.props;
const related = stats.filter((s) => s.cases.includes(frontmatter.slug));
---
<Base title={frontmatter.title} description={frontmatter.summary}>
  <article class="wrap case">
    <a class="back" href="/#work">← 사례 목록</a>
    <p class="eyebrow">{frontmatter.org} · {frontmatter.period}</p>
    <h1>{frontmatter.title}</h1>
    <p class="lead">{frontmatter.summary}</p>
    <div class="meta">
      {related.map((s) => <span class="tag">{s.label} Lv{s.level}</span>)}
    </div>
    <div class="body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .case { max-width: 720px; padding-top: 40px; padding-bottom: 80px; }
  .back { font-size: 0.9rem; text-decoration: none; }
  h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); margin: 4px 0 12px; }
  .lead { font-size: 1.1rem; color: var(--muted); }
  .meta { margin: 12px 0 28px; }
  .body :global(h2) { font-size: 1.25rem; margin-top: 2.2em; padding-top: 1em; border-top: 1px solid var(--line); }
  .body :global(li) { margin-bottom: 4px; }
</style>
